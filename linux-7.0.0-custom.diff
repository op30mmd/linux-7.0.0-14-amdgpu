+		case 0x6600:
+		case 0x6606:
+		case 0x6620:
+		case 0x6604:
+			data->cac_weights = cac_weights_mars_xt;
+			update_dte_from_pl2 = true;
+			break;
+		case 0x6611:
+		case 0x6613:
+		case 0x6608:
+			data->cac_weights = cac_weights_oland_pro;
+			update_dte_from_pl2 = true;
+			break;
+		case 0x6610:
+			data->cac_weights = cac_weights_oland_xt;
+			update_dte_from_pl2 = true;
+			break;
+		default:
+			data->cac_weights = cac_weights_oland;
+			data->lcac_config = lcac_oland;
+			data->cac_override = cac_override_oland;
+			data->powertune_data = &powertune_data_oland;
+			data->dte_data = dte_data_oland;
+			break;
+		}
+	} else if (hwmgr->chip_id == CHIP_HAINAN) {
+		data->cac_weights = cac_weights_hainan;
+		data->lcac_config = lcac_oland;
+		data->cac_override = cac_override_oland;
+		data->powertune_data = &powertune_data_hainan;
+		data->dte_data = dte_data_sun_xt;
+		update_dte_from_pl2 = true;
+	} else {
+		pr_err("Unknown SI asic revision, failed to initialize PowerTune!\n");
+		return -EINVAL;
+	}
+
+	data->enable_power_containment = false;
+	data->enable_cac = false;
+	data->enable_sq_ramping = false;
+	data->enable_dte = false;
+
+	if (data->powertune_data && data->powertune_data->enable_powertune_by_default) {
+		data->enable_power_containment = true;
+		data->enable_cac = true;
+		if (data->dte_data.enable_dte_by_default) {
+			data->enable_dte = true;
+			if (update_dte_from_pl2)
+				si_update_dte_from_pl2(hwmgr, &data->dte_data);
+		}
+		data->enable_sq_ramping = true;
+	}
+
+	/* amdgpu.si_dpm_quirks: PowerTune pieces switched off individually */
+	if (amdgpu_si_dpm_quirks & SI_QUIRK_NO_POWER_CONTAINMENT)
+		data->enable_power_containment = false;
+	if (amdgpu_si_dpm_quirks & SI_QUIRK_NO_CAC)
+		data->enable_cac = false;
+	if (amdgpu_si_dpm_quirks & SI_QUIRK_NO_SQ_RAMPING)
+		data->enable_sq_ramping = false;
+	if (amdgpu_si_dpm_quirks & SI_QUIRK_NO_DTE)
+		data->enable_dte = false;
+	if (amdgpu_si_dpm_quirks)
+		dev_info(((struct amdgpu_device *)hwmgr->adev)->dev,
+			 "si: dpm quirks 0x%x: power containment %s, cac %s, sq ramping %s, dte %s\n",
+			 amdgpu_si_dpm_quirks,
+			 data->enable_power_containment ? "on" : "off",
+			 data->enable_cac ? "on" : "off",
+			 data->enable_sq_ramping ? "on" : "off",
+			 data->enable_dte ? "on" : "off");
+
+	data->driver_calculate_cac_leakage = true;
+	data->cac_configuration_required = true;
+
+	if (data->cac_configuration_required) {
+		data->support_cac_long_term_average = true;
+		data->dyn_powertune_data.l2_lta_window_size =
+			data->powertune_data ? data->powertune_data->l2_lta_window_size_default : 0;
+		data->dyn_powertune_data.lts_truncate =
+			data->powertune_data ? data->powertune_data->lts_truncate_default : 0;
+	} else {
+		data->support_cac_long_term_average = false;
+		data->dyn_powertune_data.l2_lta_window_size = 0;
+		data->dyn_powertune_data.lts_truncate = 0;
+	}
+
+	data->dyn_powertune_data.disable_uvd_powertune = false;
+	return 0;
+}
