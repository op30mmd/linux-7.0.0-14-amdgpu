+	od_clk = value * 100;
+	if (od_clk > SI_OLAND_OD_MCLK_MAX)
+		return -EINVAL;
+	si_pi->od_mclk = od_clk;
+	return 0;
+}
+
+int si_oland_get_tdp_od(struct radeon_device *rdev)
+{
