+static bool si_should_disable_uvd_powertune(struct pp_hwmgr *hwmgr,
+					    const struct si_power_state *ps)
+{
+	struct si_hwmgr *data = hwmgr->backend;
+
+	if (data->dyn_powertune_data.disable_uvd_powertune &&
+	    ps->vclk && ps->dclk)
+		return true;
+
+	return false;
+}
