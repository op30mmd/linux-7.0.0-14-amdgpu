+/*
+ * amdgpu_ttm_evict_for_keep_pid_cb - evict one BO unless protected by keep_vram_pid
+ *
+ * Called with @bo locked and referenced by ttm_lru_walk_for_evict().
+ * Returns BO size on successful eviction (walk progress), 0 to skip this BO,
+ * or a negative error for fatal failures.
+ */
+static s64 amdgpu_ttm_evict_for_keep_pid_cb(struct ttm_lru_walk *walk,
+					    struct ttm_buffer_object *bo)
+{
+	struct amdgpu_ttm_evict_for_keep_pid_walk *ew =
+		container_of(walk, struct amdgpu_ttm_evict_for_keep_pid_walk, walk);
+	struct amdgpu_device *adev = ew->adev;
+	struct ttm_operation_ctx *ctx = walk->arg.ctx;
+	struct ttm_placement placement;
+	int ret;
+
+	/* Only VRAM is selectively evicted; walk is already VRAM-only. */
+	if (!bo->resource || bo->resource->mem_type != TTM_PL_VRAM)
+		return 0;
+
+	/* Never evict pinned or deleted BOs here. */
+	if (bo->pin_count || bo->deleted)
+		return 0;
+
+	/* Never move in-flight BOs: BOOKKEEP fences unsignaled means the GPU
+	 * may still be reading them. ttm_bo_validate() would wait in sysfs
+	 * context then move under executing IBs -> gfxhub fault at 0x0 and
+	 * CP stall (see crashes 20261004-003247 / 20261004-010820, 2-3s after
+	 * keep_vram_pid store, signaled = emitted - 3). Skip instead.
+	 */
+	if (!dma_resv_test_signaled(bo->base.resv, DMA_RESV_USAGE_BOOKKEEP))
+		return 0;
