+/* legacy r600_calculate_u_and_p() */
+static void si_calculate_u_and_p(uint32_t i, uint32_t r_c, uint32_t p_b,
+				 uint32_t *p, uint32_t *u)
+{
+	uint32_t b_c = 0;
+	uint32_t i_c;
+	uint32_t tmp;
+
+	i_c = (i * r_c) / 100;
+	tmp = i_c >> p_b;
+
+	while (tmp) {
+		b_c++;
+		tmp >>= 1;
+	}
+
+	*u = (b_c + 1) / 2;
+	*p = i_c / (1 << (2 * (*u)));
+}
