+		/* Keep the protected PID resident. */
+		if (amdgpu_bo_belongs_to_keep_pid(adev, abo))
+			return 0;
+
+		/* Respect page-table evictability like eviction_valuable(). */
+		if (bo->type == ttm_bo_type_kernel &&
+		    !amdgpu_vm_evictable(abo))
+			return 0;
+	} else {
+		/* For non-amdgpu BOs fall back to the generic valuable check. */
+		struct ttm_place place = { .mem_type = TTM_PL_VRAM };
+
+		if (!ttm_bo_eviction_valuable(bo, &place))
+			return 0;
+	}
+
+	/* Reuse the normal VRAM->GTT eviction destination. */
+	bo->bdev->funcs->evict_flags(bo, &placement);
+	ret = ttm_bo_validate(bo, &placement, ctx);
+	if (!ret)
+		return bo->base.size;
+
+	/* Non-fatal: busy / no space / pinned / interrupted -> skip this BO. */
