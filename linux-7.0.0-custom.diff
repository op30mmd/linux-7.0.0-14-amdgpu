+		ttm_manager_type(&adev->mman.bdev, TTM_PL_VRAM);
+	struct ttm_operation_ctx ctx = { };
+	struct amdgpu_ttm_evict_for_keep_pid_walk ew = {
+		.walk = {
+			.ops = &amdgpu_ttm_evict_keep_pid_ops,
+			.arg = {
+				.ctx = &ctx,
+				.trylock_only = true,
